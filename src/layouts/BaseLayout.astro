---
/**
 * Layout base: <html lang>, <head> con SEO/meta traducidos, `hreflang`
 * alternativos por idioma, Open Graph/Twitter, fuentes locales (fontsource),
 * tokens + estilos globales, textura de grano, barra de progreso y el script
 * de interacciones de cliente. El contenido de la página entra por el <slot />.
 */
import '@fontsource-variable/schibsted-grotesk/index.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@styles/tokens.css';
import '@styles/global.css';

import { getRelativeLocaleUrl } from 'astro:i18n';
import { langCodes, localeTags, defaultLang, type Lang } from '@i18n/ui';
import { useTranslations } from '@i18n/utils';
import { SITE_NAME } from '@data/site';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const title = Astro.props.title ?? t.meta.title;
const description = Astro.props.description ?? t.meta.description;

const site = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(Astro.url.pathname, site).href;
const alternates = langCodes.map((code) => ({
  hreflang: localeTags[code],
  href: new URL(getRelativeLocaleUrl(code, ''), site).href,
}));
const xDefault = new URL(getRelativeLocaleUrl(defaultLang, ''), site).href;
---

<!doctype html>
<html lang={localeTags[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={localeTags[lang]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <meta name="theme-color" content="#f2ece1" />

    <!-- Activa el sistema de reveals solo cuando hay JS (progressive enhancement). -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <div id="progress" aria-hidden="true"></div>

    <slot />

    <script>
      import '@/scripts/interactions.ts';
    </script>
  </body>
</html>
