---
/**
 * Landing, una ruta por idioma.
 *
 * Antes existía un fichero de página por idioma (`index`, `en/index`,
 * `sv/index`) con el mismo contenido. Aquí una sola ruta dinámica los genera
 * todos a partir de `langCodes`: añadir un idioma es una línea en `i18n/ui.ts`
 * y su JSON, sin tocar el enrutado.
 *
 * El idioma por defecto (es) no lleva prefijo — `params.lang: undefined`
 * produce "/" — en coherencia con `prefixDefaultLocale: false`.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Nav from '@components/layout/Nav.astro';
import Footer from '@components/layout/Footer.astro';
import Hero from '@components/sections/Hero.astro';
import About from '@components/sections/About.astro';
import Bridge from '@components/sections/Bridge.astro';
import Services from '@components/sections/Services.astro';
import Credentials from '@components/sections/Credentials.astro';
import Judge from '@components/sections/Judge.astro';
import Markets from '@components/sections/Markets.astro';
import Testimonials from '@components/sections/Testimonials.astro';
import Contact from '@components/sections/Contact.astro';
import { langCodes, defaultLang, type Lang } from '@i18n/ui';

export function getStaticPaths() {
  return langCodes.map((lang) => ({
    params: { lang: lang === defaultLang ? undefined : lang },
    props: { lang },
  }));
}

const { lang } = Astro.props as { lang: Lang };
---

<BaseLayout lang={lang}>
  <Nav lang={lang} />
  <div class="shell">
    <main>
      <Hero lang={lang} />
      <About lang={lang} />
      <Bridge lang={lang} />
      <Services lang={lang} />
      <Credentials lang={lang} />
      <Judge lang={lang} />
      <Markets lang={lang} />
      <Testimonials lang={lang} />
      <Contact lang={lang} />
    </main>
    <Footer lang={lang} />
  </div>
</BaseLayout>
