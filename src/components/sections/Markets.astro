---
/**
 * Mercados — grid 2 columnas: lista de países (con "Mercado principal" en los
 * tres primeros) + nota editorial. Bandera/código/flag principal viven en
 * `marketMeta`, emparejados por índice con `markets.items`.
 */
import { marketMeta } from '@data/site';
import { useTranslations } from '@i18n/utils';
import type { Lang } from '@i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="block" id="markets" data-screen-label="Mercados">
  <div class="wrap">
    <div class="head-row">
      <div class="head-lead">
        <span class="sec-idx reveal">{t.markets.idx}</span>
        <h2 class="sec-title reveal" set:html={t.markets.title} />
      </div>
    </div>

    <div class="mkt-grid">
      <ul class="mkt-list reveal">
        {
          t.markets.items.map((market, i) => (
            <li class:list={['mkt-item', { main: marketMeta[i]?.main }]}>
              <span class="mkt-flag" aria-hidden="true">
                {marketMeta[i]?.flag}
              </span>
              <span class="mkt-text">
                <span class="mkt-co">{market.country}</span>
                <span class="mkt-org">{market.channel}</span>
              </span>
              {marketMeta[i]?.main && <span class="mkt-main">{t.markets.main}</span>}
            </li>
          ))
        }
      </ul>

      <div class="mkt-note reveal">
        <span class="big">{t.markets.note.big}</span>
        <p set:html={t.markets.note.p} />
      </div>
    </div>
  </div>
</section>

<style>
  .mkt-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(30px, 5vw, 70px);
    align-items: start;
  }
  .mkt-list {
    display: flex;
    flex-direction: column;
    list-style: none;
  }
  .mkt-item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 18px;
    align-items: center;
    padding-block: 22px;
    border-block-end: 1px solid var(--hair);
    transition: padding-inline-start 0.3s var(--ease);
  }
  .mkt-item:first-child {
    border-block-start: 1px solid var(--hair);
  }
  .mkt-item:hover {
    padding-inline-start: 6px;
  }
  .mkt-flag {
    font-size: 24px;
    line-height: 1;
  }
  .mkt-text {
    display: grid;
    gap: 2px;
  }
  .mkt-co {
    font-size: clamp(19px, 2vw, 24px);
    font-weight: 500;
  }
  .mkt-org {
    font-size: 13px;
    color: var(--muted);
    letter-spacing: 0.02em;
  }
  .mkt-main {
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--wine);
    border: 1px solid color-mix(in oklab, var(--wine) 40%, transparent);
    border-radius: 100px;
    padding-block: 5px;
    padding-inline: 11px;
    white-space: nowrap;
  }

  .mkt-note {
    display: grid;
    gap: 22px;
    color: var(--muted);
    line-height: 1.65;
    font-size: 16px;
  }
  .mkt-note .big {
    font-family: var(--font-s);
    font-style: italic;
    font-size: clamp(26px, 3vw, 40px);
    color: var(--fg);
    line-height: 1.2;
  }
  .mkt-note :global(strong) {
    color: var(--wine);
    font-weight: 500;
  }

  @media (max-width: 820px) {
    .mkt-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
  @media (max-width: 620px) {
    .mkt-item {
      grid-template-columns: auto 1fr;
      gap: 14px;
      padding-block: 18px;
    }
    .mkt-main {
      grid-column: 2;
      justify-self: start;
      margin-block-start: 4px;
    }
  }
</style>
