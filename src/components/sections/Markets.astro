---
/**
 * Mercados — grid 2 columnas: lista de países (con "Mercado principal" en los
 * tres primeros) + nota editorial. Bandera/código/principal viven en
 * `marketMeta`, emparejados por índice con `markets.items`.
 */
import Section from '@components/ui/Section.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import Chip from '@components/ui/Chip.astro';
import { marketMeta } from '@data/site';
import { useTranslations } from '@i18n/utils';
import type { Lang } from '@i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Section id="markets" label="Mercados">
  <SectionHeader idx={t.markets.idx} title={t.markets.title} />

  <div class="grid">
    <ul class="list reveal">
      {
        t.markets.items.map((market, i) => (
          <li class="item">
            <span class="flag" aria-hidden="true">
              {marketMeta[i]?.flag}
            </span>
            <span class="text">
              <span class="co">{market.country}</span>
              <span class="org">{market.channel}</span>
            </span>
            {marketMeta[i]?.main && <Chip variant="accent">{t.markets.main}</Chip>}
          </li>
        ))
      }
    </ul>

    <div class="note reveal">
      <span class="big">{t.markets.note.big}</span>
      <p set:html={t.markets.note.p} />
    </div>
  </div>
</Section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(var(--space-xl), 5vw, var(--space-5xl));
    align-items: start;
  }

  .list {
    display: grid;
    border-block-start: var(--border-hair) solid var(--hair);
  }

  .item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--space-md);
    align-items: center;
    padding-block: var(--space-lg);
    border-block-end: var(--border-hair) solid var(--hair);
    transition: padding-inline-start var(--dur-base) var(--ease);
  }

  /* El desplazamiento al pasar el ratón es padding, no margin: no altera
     la caja de los vecinos. */
  .item:hover {
    padding-inline-start: var(--space-xs);
  }

  .flag {
    font-size: var(--text-4xl);
    line-height: var(--leading-none);
  }

  .text {
    display: grid;
    gap: var(--space-3xs);
  }

  .co {
    font-size: var(--text-3xl);
    font-weight: var(--weight-medium);
  }

  .org {
    font-size: var(--text-sm);
    color: var(--muted);
    letter-spacing: var(--tracking-wide);
  }

  .note {
    display: grid;
    gap: var(--space-lg);
    color: var(--muted);
    line-height: var(--leading-relaxed);
    font-size: var(--text-lg);
  }

  .note .big {
    font-family: var(--font-s);
    font-style: italic;
    font-size: var(--text-5xl);
    color: var(--fg);
    line-height: var(--leading-tight);
  }

  .note :global(strong) {
    color: var(--accent);
    font-weight: var(--weight-medium);
  }

  @media (--to-lg) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
  }

  @media (--to-sm) {
    /* El chip baja bajo el país en lugar de comprimir la fila. */
    .item {
      grid-template-columns: auto 1fr;
      row-gap: var(--space-xs);
      padding-block: var(--space-md);
    }
    .item :global(.chip) {
      grid-column: 2;
      justify-self: start;
    }
  }
</style>
