---
/**
 * Servicios de exportación — lista de filas numeradas (i–v en serif). Cada
 * fila: nº · título · descripción + etiquetas. Los numerales viven en
 * `serviceMeta` (datos de presentación) y se emparejan por índice con
 * `export.services.items` (copy traducida).
 */
import Section from '@components/ui/Section.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import Chip from '@components/ui/Chip.astro';
import { serviceMeta } from '@data/site';
import { useTranslations } from '@i18n/utils';
import type { Lang } from '@i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Section id="services" label="Servicios de exportación">
  <SectionHeader
    idx={t.export.services.idx}
    title={t.export.services.title}
    aside={t.export.services.aside}
  />

  <div class="list">
    {
      t.export.services.items.map((item, i) => (
        <article class="row reveal">
          <span class="num" aria-hidden="true">
            {serviceMeta[i]?.num}
          </span>
          <h3>{item.title}</h3>
          <div class="desc">
            <span>{item.desc}</span>
            <div class="tags">
              {item.tags.map((tag) => (
                <Chip>{tag}</Chip>
              ))}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</Section>

<style>
  .list {
    border-block-start: var(--border-hair) solid var(--hair);
  }

  .row {
    display: grid;
    grid-template-columns: var(--space-4xl) 1fr 1.1fr;
    gap: var(--space-xl);
    align-items: start;
    padding-block: var(--space-2xl);
    border-block-end: var(--border-hair) solid var(--hair);
    transition: background var(--dur-slow) var(--ease);
  }

  .row:hover {
    background: var(--panel);
  }

  .num {
    font-family: var(--font-s);
    font-style: italic;
    font-size: var(--text-2xl);
    color: var(--accent);
  }

  .row h3 {
    font-size: var(--text-4xl);
  }

  .desc {
    display: grid;
    gap: var(--space-md);
    color: var(--muted);
    line-height: var(--leading-relaxed);
    font-size: var(--text-md);
    max-inline-size: 48ch;
  }

  /* Rejilla envolvente: las etiquetas fluyen y saltan de línea solas. */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  @media (--to-md) {
    .row {
      grid-template-columns: var(--space-2xl) 1fr;
      gap: var(--space-xs) var(--space-md);
      padding-block: var(--space-xl);
    }
    .row h3 {
      grid-column: 2;
    }
    /* La descripción pasa a ocupar el ancho completo bajo el título. */
    .desc {
      grid-column: 1 / -1;
    }
  }
</style>
