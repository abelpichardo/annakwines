---
/**
 * Juez de vinos — sección en tema oscuro para crear contraste.
 * 3 estadísticas grandes + fila de chips. Cifras y textos son de EJEMPLO.
 *
 * No declara ni un color: `theme="dark"` invierte los tokens semánticos y
 * tanto esta sección como los componentes que contiene los heredan.
 */
import Section from '@components/ui/Section.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import Chip from '@components/ui/Chip.astro';
import { useTranslations } from '@i18n/utils';
import type { Lang } from '@i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Section id="judge" label="Juez de vinos" theme="dark">
  <SectionHeader idx={t.judge.idx} title={t.judge.title} aside={t.judge.aside} />

  <div class="body">
    <div class="stats">
      {
        t.judge.stats.map((stat) => (
          <div class="stat reveal">
            <span class="n">{stat.n}</span>
            <span class="k">{stat.k}</span>
          </div>
        ))
      }
    </div>

    <ul class="chips reveal">
      {
        t.judge.chips.map((chip) => (
          <Chip as="li" size="md">
            {chip}
          </Chip>
        ))
      }
    </ul>
  </div>
</Section>

<style>
  .body {
    display: grid;
    gap: var(--space-5xl);
  }

  /* Intrínseca: tres columnas mientras quepan, una cuando no. */
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--col-min), 1fr));
    gap: var(--space-2xl);
  }

  .stat {
    display: grid;
    gap: var(--space-sm);
    align-content: start;
  }

  .stat .n {
    font-size: clamp(2.875rem, 6vw, 5.25rem);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-tighter);
    line-height: var(--leading-none);
  }

  .stat .k {
    color: var(--faint);
    font-size: var(--text-base);
    max-inline-size: 22ch;
    line-height: var(--leading-snug);
  }

  /* Flex (no grid) a propósito: las píldoras miden lo que mide su texto y
     deben envolver en ragged-right. Grid las forzaría a una pista común. */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    border-block-start: var(--border-hair) solid var(--hair-2);
    padding-block-start: var(--space-xl);
  }

  @media (--to-sm) {
    .body {
      gap: var(--space-2xl);
    }
  }
</style>
