---
/**
 * Qué hago / Puente — cabecera + "escenario": España · La bodega ⟷ anillo
 * central "Anna" ⟷ Norte de Europa · La mesa. Colapsa a 1 columna en tablet.
 */
import Section from '@components/ui/Section.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import { useTranslations } from '@i18n/utils';
import type { Lang } from '@i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Section id="bridge" label="Qué hago">
  <SectionHeader idx={t.bridge.idx} title={t.bridge.title} aside={t.bridge.aside} />

  <div class="stage">
    <div class="side reveal">
      <span class="kick">{t.bridge.left.kick}</span>
      <h3>{t.bridge.left.h}</h3>
      <p>{t.bridge.left.p}</p>
    </div>

    <div class="mid reveal" aria-hidden="true">
      <div class="ring"><span>{t.bridge.ring}</span></div>
      <span class="dot"></span>
    </div>

    <div class="side right reveal">
      <span class="kick">{t.bridge.right.kick}</span>
      <h3>{t.bridge.right.h}</h3>
      <p>{t.bridge.right.p}</p>
    </div>
  </div>
</Section>

<style>
  .stage {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: clamp(var(--space-md), 4vw, var(--space-4xl));
  }

  .side {
    display: grid;
    gap: var(--space-md);
    align-content: start;
  }

  /* La columna derecha se alinea a su borde: justify-items, no margins. */
  .side.right {
    text-align: right;
    justify-items: end;
  }

  .kick {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--accent);
  }

  .side h3 {
    font-size: var(--text-5xl);
  }

  .side p {
    color: var(--muted);
    max-inline-size: var(--measure-narrow);
    line-height: var(--leading-normal);
    font-size: var(--text-md);
  }

  .mid {
    display: grid;
    place-items: center;
    gap: var(--space-sm);
  }

  .ring {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: var(--size-ring);
    block-size: var(--size-ring);
    border-radius: var(--radius-circle);
    border: var(--border-hair) solid var(--hair);
    font-family: var(--font-s);
    font-style: italic;
    font-size: var(--text-xl);
    text-align: center;
    line-height: 1.05;
  }

  /* Los filetes que salen del anillo hacia cada columna. */
  .ring::before,
  .ring::after {
    content: '';
    position: absolute;
    inset-block-start: 50%;
    inline-size: clamp(var(--space-md), 4vw, var(--space-4xl));
    block-size: var(--border-hair);
    background: var(--hair);
  }
  .ring::before {
    inset-inline-end: 100%;
  }
  .ring::after {
    inset-inline-start: 100%;
  }

  .dot {
    inline-size: var(--space-xs);
    block-size: var(--space-xs);
    border-radius: var(--radius-circle);
    background: var(--accent);
  }

  @media (--to-lg) {
    .stage {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
      text-align: left;
    }
    .side.right {
      text-align: left;
      justify-items: start;
    }
    /* Apilado, los filetes laterales del anillo ya no conectan nada. */
    .ring::before,
    .ring::after {
      display: none;
    }
  }
</style>
