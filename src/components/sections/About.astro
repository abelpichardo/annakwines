---
/**
 * Sobre Anna — grid 2 columnas (retrato / bio). La bio usa `gap` para el
 * ritmo vertical (nada de margins en cascada): índice, título, párrafos, cita
 * en serif y firma.
 */
import PortraitPlate from '@components/ui/PortraitPlate.astro';
import { useTranslations } from '@i18n/utils';
import type { Lang } from '@i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="block about" id="about" data-screen-label="Sobre Anna">
  <div class="wrap">
    <div class="about-grid">
      <div class="about-photo reveal">
        <PortraitPlate alt={t.portrait.cap} caption={t.portrait.cap} badge={t.portrait.badge} />
      </div>
      <div class="about-bio">
        <span class="sec-idx reveal">{t.about.idx}</span>
        <h2 class="sec-title reveal" set:html={t.about.title} />
        <p class="reveal" set:html={t.about.p1} />
        <p class="reveal">{t.about.p2}</p>
        <blockquote class="about-quote reveal">{t.about.quote}</blockquote>
        <p class="reveal">{t.about.p3}</p>
        <div class="about-sign reveal">
          <span class="sign-mono" aria-hidden="true">AK</span>
          <div>
            <div class="nm">Anna K.</div>
            <div class="rl">{t.about.signRole}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(40px, 6vw, 90px);
    align-items: center;
  }
  .about-bio {
    display: grid;
    gap: 22px;
    align-content: start;
  }
  .about-bio .sec-title {
    margin-block-start: -4px;
  }
  .about-bio p {
    font-size: clamp(17px, 1.5vw, 21px);
    line-height: 1.65;
    color: var(--ink-2);
    max-width: 52ch;
  }
  .about-bio :global(.lead-in) {
    font-family: var(--font-s);
    font-style: italic;
    font-size: 1.25em;
    color: var(--wine);
  }
  .about-quote {
    font-family: var(--font-s);
    font-style: italic;
    font-size: clamp(24px, 3vw, 38px);
    line-height: 1.25;
    letter-spacing: -0.01em;
    padding-block: 8px;
  }
  .about-sign {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-block-start: 8px;
  }
  .sign-mono {
    display: inline-grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--wine);
    color: var(--wine);
    font-family: var(--font-s);
    font-style: italic;
  }
  .about-sign .nm {
    font-family: var(--font-s);
    font-style: italic;
    font-size: 24px;
  }
  .about-sign .rl {
    font-size: 13px;
    color: var(--muted);
    letter-spacing: 0.04em;
  }
  @media (max-width: 980px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .about-photo {
      max-width: 360px;
      margin-inline: auto;
    }
  }
</style>
