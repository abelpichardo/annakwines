---
/**
 * Hero — variante "centrado" (decisión de diseño: sin retrato, todo centrado).
 * Eyebrow · título grande con segunda línea en serif itálica vino · subtítulo ·
 * "toast" Salud → Skål. El título entra con slide-up enmascarado (.line-mask).
 */
import Section from '@components/ui/Section.astro';
import Kicker from '@components/ui/Kicker.astro';
import { useTranslations } from '@i18n/utils';
import type { Lang } from '@i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Section as="header" variant="hero" id="top" label="Hero">
  <div class="copy">
    <Kicker class="reveal">{t.hero.eyebrow}</Kicker>
    <span class="line-mask">
      <h1 class="title line-in" set:html={t.hero.title} />
    </span>
    <p class="sub reveal">{t.hero.sub}</p>
    <div class="toast reveal">
      <b>{t.hero.toast.a}</b>
      <span class="arr" aria-hidden="true">→</span>
      <b>{t.hero.toast.b}</b>
      <span class="lbl">{t.hero.toast.label}</span>
    </div>
  </div>
</Section>

<style>
  .copy {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: clamp(var(--space-lg), 3.4vw, var(--space-xl));
    inline-size: 100%;
  }

  .title {
    font-size: var(--text-8xl);
    font-weight: var(--weight-medium);
    line-height: 0.92;
    letter-spacing: var(--tracking-tighter);
  }

  /* La cursiva vino llega dentro del título desde los diccionarios i18n. */
  .title :global(.serif) {
    display: inline-block;
    color: var(--accent);
  }

  .sub {
    max-inline-size: 46ch;
    color: var(--muted);
    font-size: clamp(var(--text-lg), 1.5vw, 1.3125rem);
    line-height: var(--leading-normal);
  }

  .toast {
    display: grid;
    grid-auto-flow: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    font-size: var(--text-base);
    letter-spacing: var(--tracking-wide);
    color: var(--muted);
  }

  .toast b {
    color: var(--fg);
    font-weight: var(--weight-semibold);
  }

  .toast .arr {
    color: var(--accent);
    font-family: var(--font-s);
    font-style: italic;
    font-size: var(--text-2xl);
  }

  @media (--to-sm) {
    /* El "toast" pasa a rejilla envolvente: cuatro piezas no caben en fila. */
    .toast {
      grid-auto-flow: row;
      gap: var(--space-xs);
    }
    .sub {
      font-size: var(--text-xl);
    }
  }
</style>
