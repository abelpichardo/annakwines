---
/**
 * Contacto — pieza protagonista. Cabecera grande + grid 2 columnas:
 *   izquierda → 4 métodos de contacto directos + reassurance ("respondo en <48 h").
 *   derecha   → formulario en tarjeta elevada (ContactForm).
 *
 * Iconos: Mail y MessageCircle vía Lucide; Instagram y LinkedIn como SVG
 * inline porque Lucide ya no incluye iconos de marca. Los métodos se recorren
 * desde un array local para no repetir cuatro veces el mismo marcado.
 */
import Section from '@components/ui/Section.astro';
import ContactForm from '@components/sections/ContactForm.astro';
import Icon from '@components/ui/Icon.astro';
import Mail from '@lucide/astro/icons/mail';
import MessageCircle from '@lucide/astro/icons/message-circle';
import { contact } from '@data/site';
import { useTranslations } from '@i18n/utils';
import type { Lang } from '@i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const m = t.contact.methods;

/** Los cuatro métodos, en orden de preferencia de respuesta. */
const methods = [
  {
    key: 'mail',
    href: `mailto:${contact.email}`,
    label: contact.email,
    sub: m.emailSub,
    external: false,
  },
  {
    key: 'wa',
    href: contact.whatsapp.href,
    label: contact.whatsapp.display,
    sub: m.waSub,
    external: true,
  },
  {
    key: 'ig',
    href: contact.instagram.href,
    label: contact.instagram.display,
    sub: m.igSub,
    external: true,
  },
  {
    key: 'li',
    href: contact.linkedin.href,
    label: contact.linkedin.display,
    sub: m.liSub,
    external: true,
  },
] as const;
---

<Section id="contact" label="Contacto" variant="tail">
  <div class="head">
    <span class="idx reveal">{t.contact.idx}</span>
    <h2 class="big reveal" set:html={t.contact.title} />
    <p class="aside reveal">{t.contact.aside}</p>
  </div>

  <div class="grid">
    <div class="side">
      <div class="methods">
        {
          methods.map((method) => (
            <a
              class="cm reveal"
              href={method.href}
              target={method.external ? '_blank' : undefined}
              rel={method.external ? 'noopener noreferrer' : undefined}
            >
              <span class="cm-l">
                <span class="ic">
                  {method.key === 'mail' && <Icon icon={Mail} />}
                  {method.key === 'wa' && <Icon icon={MessageCircle} />}
                  {method.key === 'ig' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                      <rect x="3" y="3" width="18" height="18" rx="5" />
                      <circle cx="12" cy="12" r="4" />
                      <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" />
                    </svg>
                  )}
                  {method.key === 'li' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                      <rect x="3" y="3" width="18" height="18" rx="2" />
                      <path d="M7 10v7M7 7v.01M11 17v-4a2 2 0 0 1 4 0v4M11 10v7" />
                    </svg>
                  )}
                </span>
                <span class="cm-text">
                  <span class="ct">{method.label}</span>
                  <span class="cs">{method.sub}</span>
                </span>
              </span>
              <span class="ar" aria-hidden="true">
                ↗
              </span>
            </a>
          ))
        }
      </div>

      <div class="reassure reveal">
        <span class="dot" aria-hidden="true"></span>
        <span>{t.contact.reassure}</span>
      </div>
    </div>

    <ContactForm lang={lang} />
  </div>
</Section>

<style>
  .head {
    display: grid;
    gap: var(--space-lg);
    max-inline-size: var(--content-width);
    padding-block-end: var(--space-4xl);
  }

  .idx {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--accent);
  }

  .big {
    font-size: var(--text-7xl);
    line-height: 0.95;
    letter-spacing: var(--tracking-tighter);
  }

  .big :global(.serif) {
    color: var(--accent);
  }

  .aside {
    color: var(--muted);
    font-size: var(--text-xl);
    max-inline-size: var(--measure-aside);
    line-height: var(--leading-normal);
  }

  .grid {
    display: grid;
    grid-template-columns: 0.82fr 1.18fr;
    gap: clamp(var(--space-xl), 5vw, var(--space-5xl));
    align-items: start;
  }

  .side {
    display: grid;
    align-content: start;
    gap: var(--space-xl);
  }

  .methods {
    display: grid;
  }

  .cm {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-lg);
    padding-block: var(--space-lg);
    border-block-start: var(--border-hair) solid var(--hair);
    transition: padding-inline-start var(--dur-base) var(--ease);
  }

  .cm:last-child {
    border-block-end: var(--border-hair) solid var(--hair);
  }

  .cm-l {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: var(--space-md);
  }

  .ic {
    inline-size: var(--size-icon);
    block-size: var(--size-icon);
    color: var(--accent);
  }

  .ic :global(svg) {
    inline-size: 100%;
    block-size: 100%;
    stroke-width: 1.6;
  }

  .cm-text {
    display: grid;
    gap: var(--space-3xs);
  }

  .ct {
    font-weight: var(--weight-medium);
    font-size: var(--text-xl);
  }

  .cs {
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .ar {
    font-family: var(--font-s);
    font-style: italic;
    color: var(--faint);
    transition:
      transform var(--dur-base) var(--ease),
      color var(--dur-base) var(--ease);
  }

  .cm:hover {
    padding-inline-start: var(--space-xs);
  }

  .cm:hover .ar {
    color: var(--accent);
    transform: translate(var(--space-2xs), calc(var(--space-2xs) * -1));
  }

  .reassure {
    display: grid;
    grid-auto-flow: column;
    justify-content: start;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--text-base);
    color: var(--muted);
  }

  .dot {
    inline-size: var(--size-dot);
    block-size: var(--size-dot);
    border-radius: var(--radius-circle);
    background: var(--green);
    box-shadow: 0 0 0 var(--space-2xs) color-mix(in oklab, var(--green) 22%, transparent);
  }

  @media (--to-lg) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }
  }
</style>
