---
/**
 * Bodegas / Testimonios — cabecera + rejilla de citas (serif) con avatar de
 * inicial, y una fila de "logos" (píldoras) como placeholders de bodegas.
 * Contenido de EJEMPLO.
 */
import Section from '@components/ui/Section.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import Card from '@components/ui/Card.astro';
import Seal from '@components/ui/Seal.astro';
import Chip from '@components/ui/Chip.astro';
import { testimonialMeta, wineryLogos } from '@data/site';
import { useTranslations } from '@i18n/utils';
import type { Lang } from '@i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Section id="testi" label="Testimonios">
  <SectionHeader
    idx={t.testimonials.idx}
    title={t.testimonials.title}
    aside={t.testimonials.aside}
  />

  <div class="body">
    <div class="grid">
      {
        t.testimonials.items.map((item, i) => (
          <Card as="figure" interactive class="testi reveal">
            <blockquote class="q">{item.quote}</blockquote>
            <figcaption class="by">
              <Seal shape="circle" size="xl" filled>
                {testimonialMeta[i]?.avatar}
              </Seal>
              <span class="who">
                <span class="nm">{item.name}</span>
                <span class="meta">{item.meta}</span>
              </span>
            </figcaption>
          </Card>
        ))
      }
    </div>

    <div class="logos reveal">
      <span class="lbl">{t.testimonials.logosLabel}</span>
      {wineryLogos.map((logo) => <Chip variant="serif">{logo}</Chip>)}
    </div>
  </div>
</Section>

<style>
  .body {
    display: grid;
    gap: var(--space-3xl);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--col-min), 1fr));
    gap: var(--space-lg);
  }

  /* `1fr auto` empuja la firma al fondo de la tarjeta sin `margin-top: auto`,
     de modo que todas las citas alinean su pie aunque midan distinto. */
  .testi {
    grid-template-rows: 1fr auto;
  }

  .q {
    font-family: var(--font-s);
    font-style: italic;
    font-size: var(--text-3xl);
    line-height: var(--leading-snug);
  }

  .by {
    display: grid;
    grid-auto-flow: column;
    justify-content: start;
    align-items: center;
    gap: var(--space-md);
  }

  .who {
    display: grid;
  }

  .nm {
    font-weight: var(--weight-semibold);
    font-size: var(--text-md);
  }

  .meta {
    font-size: var(--text-sm);
    color: var(--muted);
  }

  /* Flex (no grid) a propósito: las píldoras miden lo que mide su texto y
     deben envolver en ragged-right. Grid las forzaría a una pista común. */
  .logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
  }

  .lbl {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--faint);
  }
</style>
