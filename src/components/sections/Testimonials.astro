---
/**
 * Bodegas / Testimonios — head-row + grid 2 columnas de citas (serif) con
 * avatar de inicial, y una fila de "logos" (píldoras de texto) como
 * placeholders de bodegas. Contenido de EJEMPLO.
 */
import { testimonialMeta, wineryLogos } from '@data/site';
import { useTranslations } from '@i18n/utils';
import type { Lang } from '@i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="block" id="testi" data-screen-label="Testimonios">
  <div class="wrap">
    <div class="head-row">
      <div class="head-lead">
        <span class="sec-idx reveal">{t.testimonials.idx}</span>
        <h2 class="sec-title reveal" set:html={t.testimonials.title} />
      </div>
      <p class="sec-aside reveal">{t.testimonials.aside}</p>
    </div>

    <div class="testi-body">
      <div class="testi-grid">
        {
          t.testimonials.items.map((item, i) => (
            <figure class="testi reveal">
              <blockquote class="q">{item.quote}</blockquote>
              <figcaption class="by">
                <span class="av serif" aria-hidden="true">
                  {testimonialMeta[i]?.avatar}
                </span>
                <span>
                  <span class="nm">{item.name}</span>
                  <span class="meta">{item.meta}</span>
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>

      <div class="logos reveal">
        <span class="lbl">{t.testimonials.logosLabel}</span>
        {wineryLogos.map((logo) => <span class="lg">{logo}</span>)}
      </div>
    </div>
  </div>
</section>

<style>
  .testi-body {
    display: grid;
    gap: 54px;
  }
  .testi-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
  }
  .testi {
    display: flex;
    flex-direction: column;
    gap: 22px;
    border: 1px solid var(--hair);
    padding: 36px;
    transition: border-color 0.4s var(--ease);
  }
  .testi:hover {
    border-color: color-mix(in oklab, var(--wine) 40%, var(--hair));
  }
  .testi .q {
    font-family: var(--font-s);
    font-style: italic;
    font-size: clamp(20px, 2.2vw, 27px);
    line-height: 1.35;
  }
  .testi .by {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-block-start: auto;
  }
  .testi .av {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--panel);
    border: 1px solid var(--hair);
    color: var(--wine);
    flex-shrink: 0;
  }
  .testi .nm {
    display: block;
    font-weight: 600;
    font-size: 15px;
  }
  .testi .meta {
    display: block;
    font-size: 13px;
    color: var(--muted);
  }

  .logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }
  .logos .lbl {
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--faint);
    margin-inline-end: 8px;
  }
  .logos .lg {
    font-family: var(--font-s);
    font-style: italic;
    font-size: 17px;
    color: var(--faint);
    border: 1px solid var(--hair);
    border-radius: 100px;
    padding-block: 10px;
    padding-inline: 20px;
  }

  @media (max-width: 720px) {
    .testi-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
