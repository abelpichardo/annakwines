---
/**
 * Formulario de contacto — pieza protagonista, en tarjeta elevada.
 * Campos: Nombre+Bodega, Email+Teléfono, Mercado+Servicio (selects), Mensaje.
 *
 * El envío lo intercepta el script de interacciones (muestra `.ok` y resetea).
 * PENDIENTE: no hay backend ni protección anti-bot — conectar a un endpoint
 * real y añadir verificación en servidor antes de publicar.
 */
import Card from '@components/ui/Card.astro';
import Button from '@components/ui/Button.astro';
import Icon from '@components/ui/Icon.astro';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import { marketMeta } from '@data/site';
import { useTranslations } from '@i18n/utils';
import type { Lang } from '@i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const f = t.contact.form;

const serviceCodes = ['export', 'rep', 'consult', 'tasting'] as const;
---

<Card as="form" variant="raised" class="form reveal" id="contact-form" novalidate>
  <div class="head">
    <h3>{f.heading}</h3>
    <p>{f.sub}</p>
  </div>

  <div class="row">
    <div class="field">
      <label for="cf-name">{f.name}</label>
      <input
        id="cf-name"
        type="text"
        name="name"
        autocomplete="name"
        placeholder={f.namePh}
        required
      />
    </div>
    <div class="field">
      <label for="cf-winery">{f.winery}</label>
      <input
        id="cf-winery"
        type="text"
        name="winery"
        autocomplete="organization"
        placeholder={f.wineryPh}
      />
    </div>
  </div>

  <div class="row">
    <div class="field">
      <label for="cf-email">{f.email}</label>
      <input
        id="cf-email"
        type="email"
        name="email"
        autocomplete="email"
        placeholder={f.emailPh}
        required
      />
    </div>
    <div class="field">
      <label for="cf-phone">{f.phone}</label>
      <input id="cf-phone" type="tel" name="phone" autocomplete="tel" placeholder={f.phonePh} />
    </div>
  </div>

  <div class="row">
    <div class="field">
      <label for="cf-market">{f.market}</label>
      <div class="select-wrap">
        <select id="cf-market" name="market">
          <option value="">{f.marketAny}</option>
          {
            t.markets.items.map((market, i) => (
              <option value={marketMeta[i]?.code}>{market.country}</option>
            ))
          }
          <option value="all">{f.marketAll}</option>
        </select>
        <Icon icon={ChevronDown} class="arr" size={16} strokeWidth={2} />
      </div>
    </div>
    <div class="field">
      <label for="cf-service">{f.service}</label>
      <div class="select-wrap">
        <select id="cf-service" name="service">
          <option value="">{f.serviceAny}</option>
          {
            t.services.items.map((service, i) => (
              <option value={serviceCodes[i]}>{service.title}</option>
            ))
          }
        </select>
        <Icon icon={ChevronDown} class="arr" size={16} strokeWidth={2} />
      </div>
    </div>
  </div>

  <div class="field">
    <label for="cf-message">{f.msg}</label>
    <textarea id="cf-message" name="message" placeholder={f.msgPh} required></textarea>
  </div>

  <div class="foot">
    <Button type="submit" variant="solid">{f.btn}</Button>
    <span class="priv">{f.privacy}</span>
  </div>

  <p class="ok" id="form-ok" role="status" aria-live="polite">{f.ok}</p>
</Card>

<style>
  .head {
    display: grid;
    gap: var(--space-xs);
  }

  .head h3 {
    font-size: var(--text-3xl);
    letter-spacing: -0.02em;
  }

  .head p {
    font-size: var(--text-md);
    color: var(--muted);
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
  }

  .field {
    display: grid;
    align-content: start;
    gap: var(--space-xs);
  }

  .field label {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--muted);
  }

  .field input,
  .field textarea,
  .field select {
    font-family: inherit;
    font-size: var(--text-lg);
    color: var(--fg);
    background: transparent;
    border: none;
    border-block-end: var(--border-hair) solid var(--hair);
    padding-block: var(--space-sm);
    padding-inline: var(--space-3xs);
    inline-size: 100%;
    transition: border-color var(--dur-base) var(--ease);
  }

  .field textarea {
    min-block-size: 7rem;
    resize: vertical;
  }

  .field input:focus,
  .field textarea:focus,
  .field select:focus {
    outline: none;
    border-color: var(--accent);
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--faint);
  }

  .select-wrap {
    position: relative;
  }

  .select-wrap select {
    appearance: none;
    cursor: pointer;
    padding-inline-end: var(--space-lg);
  }

  .select-wrap :global(.arr) {
    position: absolute;
    inset-inline-end: var(--space-3xs);
    inset-block-end: var(--space-sm);
    color: var(--muted);
    pointer-events: none;
  }

  .select-wrap select option {
    background: var(--bg);
    color: var(--fg);
  }

  /* Flex (no grid) a propósito: el botón y la nota legal deben poder
     envolver conservando cada uno su ancho natural. */
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-lg);
  }

  .priv {
    font-size: var(--text-xs);
    color: var(--faint);
  }

  /* Ocupa su hueco desde el principio: al mostrarse no desplaza el botón. */
  .ok {
    color: var(--green);
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease);
  }

  .ok.show {
    opacity: 1;
  }

  @media (--to-sm) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
