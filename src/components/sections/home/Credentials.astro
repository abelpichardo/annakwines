---
/**
 * Formación y acreditaciones — rejilla de tarjetas separadas por filetes de
 * 1px (truco del `gap` sobre fondo `--hair`). Cada tarjeta: sello con
 * inicial + título + organismo emisor.
 */
import Section from '@components/ui/Section.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import Seal from '@components/ui/Seal.astro';
import { certMeta } from '@data/site';
import { useTranslations } from '@i18n/utils';
import type { Lang } from '@i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Section id="certs" label="Acreditaciones">
  <SectionHeader idx={t.home.certs.idx} title={t.home.certs.title} aside={t.home.certs.aside} />

  <div class="grid">
    {
      t.home.certs.items.map((cert, i) => (
        <article class="cert reveal">
          <Seal shape="circle" size="lg" tone="accent">
            {certMeta[i]?.seal}
          </Seal>
          <h4>{cert.title}</h4>
          <span class="org">{cert.org}</span>
        </article>
      ))
    }
  </div>
</Section>

<style>
  /* Layout intrínseco: el número de columnas lo decide el ancho disponible,
     sin ningún breakpoint. El `gap` de 1px sobre el fondo dibuja los filetes. */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--col-min), 1fr));
    gap: var(--border-hair);
    background: var(--hair);
    border: var(--border-hair) solid var(--hair);
  }

  .cert {
    display: grid;
    align-content: start;
    gap: var(--space-sm);
    background: var(--bg);
    padding: var(--space-xl);
    min-block-size: 11rem;
    transition: background var(--dur-slow) var(--ease);
  }

  .cert:hover {
    background: var(--panel);
  }

  .cert h4 {
    font-size: var(--text-2xl);
    letter-spacing: -0.01em;
  }

  .cert .org {
    font-size: var(--text-sm);
    color: var(--muted);
  }
</style>
