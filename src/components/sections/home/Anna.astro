---
/**
 * Quién está detrás — grid 2 columnas (retrato / bio). Es la sección que
 * da credibilidad a las dos patas del negocio a la vez, así que vive en la
 * home y no dentro de ninguna de las dos.
 */
import Section from '@components/ui/Section.astro';
import PortraitPlate from '@components/ui/PortraitPlate.astro';
import Seal from '@components/ui/Seal.astro';
import { useTranslations } from '@i18n/utils';
import type { Lang } from '@i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Section id="anna" label="Quién está detrás">
  <div class="grid">
    <div class="photo reveal">
      <PortraitPlate alt={t.portrait.alt} caption={t.portrait.cap} badge={t.portrait.badge} />
    </div>

    <div class="bio">
      <span class="idx reveal">{t.home.anna.idx}</span>
      <h2 class="title reveal" set:html={t.home.anna.title} />
      <p class="reveal" set:html={t.home.anna.p1} />
      <p class="reveal">{t.home.anna.p2}</p>
      <blockquote class="quote reveal">{t.home.anna.quote}</blockquote>
      <p class="reveal">{t.home.anna.p3}</p>

      <div class="sign reveal">
        <Seal shape="square" size="lg" tone="accent">AK</Seal>
        <div class="sign-text">
          <span class="nm">Anna K.</span>
          <span class="rl">{t.home.anna.signRole}</span>
        </div>
      </div>
    </div>
  </div>
</Section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(var(--space-2xl), 6vw, var(--space-6xl));
    align-items: center;
  }

  .bio {
    display: grid;
    gap: var(--space-lg);
    align-content: start;
  }

  .idx {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--accent);
  }

  .title {
    font-size: var(--text-6xl);
  }

  .bio p {
    font-size: var(--text-xl);
    line-height: var(--leading-relaxed);
    color: var(--fg-body);
    max-inline-size: var(--measure);
  }

  /* Entradilla en serif que abre el primer párrafo (viene del diccionario). */
  .bio :global(.lead-in) {
    font-family: var(--font-s);
    font-style: italic;
    font-size: 1.25em;
    color: var(--accent);
  }

  .quote {
    font-family: var(--font-s);
    font-style: italic;
    font-size: var(--text-5xl);
    line-height: var(--leading-tight);
    letter-spacing: -0.01em;
    padding-block: var(--space-xs);
  }

  .sign {
    display: grid;
    grid-auto-flow: column;
    justify-content: start;
    align-items: center;
    gap: var(--space-md);
    padding-block-start: var(--space-xs);
  }

  .sign-text {
    display: grid;
  }

  .sign .nm {
    font-family: var(--font-s);
    font-style: italic;
    font-size: var(--text-4xl);
  }

  .sign .rl {
    font-size: var(--text-sm);
    color: var(--muted);
    letter-spacing: var(--tracking-wide);
  }

  @media (--to-lg) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }
    /* El retrato se centra desde la rejilla, no con un margin propio. */
    .photo {
      justify-self: center;
    }
  }
</style>
