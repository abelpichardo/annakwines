---
/**
 * Cabecera de catas y enoturismo. Presenta la submarca Costa Blanca Wine
 * Club firmada por Anna K Wines: la marca local es la que busca la gente en
 * redes, y el respaldo es lo que la hace creíble.
 *
 * Comparte `HeroEyebrow` con las otras dos páginas (misma tipografía, sin
 * filete) y cierra con `HeroFacts`.
 */
import Section from '@components/ui/Section.astro';
import HeroEyebrow from '@components/ui/HeroEyebrow.astro';
import HeroFacts from '@components/ui/HeroFacts.astro';
import { useTranslations } from '@i18n/utils';
import type { Lang } from '@i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Section as="header" id="top" label="Catas y enoturismo">
  <div class="copy">
    <HeroEyebrow class="reveal" label={t.tastings.hero.brand} secondary={t.tastings.hero.eyebrow} />
    <span class="line-mask">
      <h1 class="title line-in" set:html={t.tastings.hero.title} />
    </span>
    <p class="sub reveal">{t.tastings.hero.sub}</p>
    <HeroFacts class="reveal" facts={t.tastings.hero.facts} />
  </div>
</Section>

<style>
  .copy {
    display: grid;
    gap: var(--space-lg);
    padding-block: var(--space-5xl) var(--space-2xl);
  }

  .title {
    font-size: var(--text-7xl);
    font-weight: var(--weight-medium);
    line-height: 0.95;
    letter-spacing: var(--tracking-tighter);
  }

  .title :global(.serif) {
    color: var(--accent);
  }

  .sub {
    color: var(--muted);
    font-size: var(--text-xl);
    max-inline-size: var(--measure);
    line-height: var(--leading-normal);
  }
</style>
