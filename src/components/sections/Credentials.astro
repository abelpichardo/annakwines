---
/**
 * Acreditaciones — grid 2×3 de tarjetas separadas por líneas de 1px. Cada
 * tarjeta: sello circular con inicial (serif, borde vino) + título + organismo.
 * Contenido de EJEMPLO — sustituir por las certificaciones reales.
 */
import { certMeta } from '@data/site';
import { useTranslations } from '@i18n/utils';
import type { Lang } from '@i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="block" id="certs" data-screen-label="Acreditaciones">
  <div class="wrap">
    <div class="head-row">
      <div class="head-lead">
        <span class="sec-idx reveal">{t.certs.idx}</span>
        <h2 class="sec-title reveal" set:html={t.certs.title} />
      </div>
      <p class="sec-aside reveal">{t.certs.aside}</p>
    </div>

    <div class="cert-grid">
      {
        t.certs.items.map((cert, i) => (
          <article class="cert reveal">
            <span class="seal serif" aria-hidden="true">
              {certMeta[i]?.seal}
            </span>
            <h4>{cert.title}</h4>
            <span class="org">{cert.org}</span>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cert-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--hair);
    border: 1px solid var(--hair);
  }
  .cert {
    background: var(--bg);
    padding: 34px;
    display: grid;
    gap: 10px;
    align-content: start;
    min-height: 180px;
    transition: background 0.4s;
  }
  .cert:hover {
    background: var(--panel);
  }
  .cert .seal {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--wine);
    color: var(--wine);
    font-size: 16px;
    margin-block-end: 6px;
  }
  .cert h4 {
    font-size: 19px;
    letter-spacing: -0.01em;
  }
  .cert .org {
    font-size: 13px;
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .cert-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
