---
/**
 * Chip / píldora reutilizable (borde fino, texto en versalitas).
 * Se usa para las etiquetas de cada servicio. Contenido vía slot.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['tag', className]}><slot /></span>

<style>
  .tag {
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--faint);
    border: 1px solid var(--hair);
    border-radius: 100px;
    padding-block: 5px;
    padding-inline: 11px;
    white-space: nowrap;
  }
</style>
