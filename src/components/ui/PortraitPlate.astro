---
/**
 * Retrato sobre un "plato" de papel, con badge superior opcional y caption
 * vertical lateral. La imagen se optimiza vía `astro:assets` y usa
 * `mix-blend-mode: multiply` para fundirse con el fondo hueso.
 */
import { Image } from 'astro:assets';
import portrait from '../../assets/annak-portrait.png';

interface Props {
  alt: string;
  caption?: string;
  badge?: string;
  class?: string;
}
const { alt, caption, badge, class: className } = Astro.props;
---

<figure class:list={['portrait-plate', className]}>
  {badge && <span class="portrait-badge serif">{badge}</span>}
  <Image src={portrait} alt={alt} widths={[316, 480, 632]} sizes="(max-width: 980px) 78vw, 420px" />
  {caption && <figcaption class="portrait-cap">{caption}</figcaption>}
</figure>

<style>
  .portrait-plate {
    position: relative;
    width: min(420px, 80%);
    margin-inline: auto 0;
    background: var(--paper);
    box-shadow:
      0 40px 90px -50px rgba(40, 20, 15, 0.5),
      0 2px 0 rgba(255, 255, 255, 0.6) inset;
  }
  .portrait-plate::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: 0 0 0 1px var(--hair-2) inset;
    pointer-events: none;
  }
  .portrait-plate :global(img) {
    width: 100%;
    height: auto;
    mix-blend-mode: multiply;
  }
  .portrait-badge {
    position: absolute;
    inset-block-start: -18px;
    inset-inline-start: -18px;
    background: var(--wine);
    color: var(--bone);
    font-size: 15px;
    padding-block: 12px;
    padding-inline: 16px;
    line-height: 1.1;
    max-width: 130px;
    z-index: 1;
  }
  .portrait-cap {
    position: absolute;
    inset-inline-start: -14px;
    inset-block-end: 26px;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--faint);
  }
  @media (max-width: 980px) {
    .portrait-plate {
      width: min(360px, 78%);
      margin-inline: 0;
    }
  }
  @media (max-width: 620px) {
    .portrait-plate {
      width: min(300px, 86%);
    }
    .portrait-badge {
      font-size: 13px;
      padding-block: 10px;
      padding-inline: 13px;
      inset-block-start: -14px;
      inset-inline-start: -10px;
    }
    .portrait-cap {
      inset-inline-start: -10px;
      font-size: 10px;
    }
  }
</style>
