---
/**
 * Retrato sobre un "plato" de papel, con badge superior opcional y caption
 * vertical lateral. La imagen se optimiza vía `astro:assets` y usa
 * `mix-blend-mode: multiply` para fundirse con el fondo hueso.
 *
 * El componente no se posiciona a sí mismo: la alineación la decide la
 * rejilla que lo contiene (`justify-items`), no un margin propio.
 *
 * `data-parallax` es el punto de anclaje del script de interacciones: se
 * apunta a un atributo, no a una clase de estilo, para que renombrar el CSS
 * no rompa el comportamiento.
 */
import { Image } from 'astro:assets';
import portrait from '@assets/annak-portrait.png';

interface Props {
  alt: string;
  caption?: string;
  badge?: string;
  class?: string;
}
const { alt, caption, badge, class: className } = Astro.props;
---

<figure class:list={['plate', className]} data-parallax>
  {badge && <span class="badge serif">{badge}</span>}
  <Image src={portrait} alt={alt} widths={[316, 480, 632]} sizes="(max-width: 980px) 78vw, 420px" />
  {caption && <figcaption class="cap">{caption}</figcaption>}
</figure>

<style>
  .plate {
    position: relative;
    inline-size: min(var(--portrait-w), 100%);
    background: var(--paper);
    box-shadow: var(--shadow-plate);
  }

  /* Filete interior de 1px sin sumar al box model. */
  .plate::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: 0 0 0 var(--border-hair) var(--hair-2) inset;
    pointer-events: none;
  }

  .plate :global(img) {
    inline-size: 100%;
    block-size: auto;
    mix-blend-mode: multiply;
  }

  .badge {
    position: absolute;
    inset-block-start: calc(var(--space-md) * -1);
    inset-inline-start: calc(var(--space-md) * -1);
    z-index: 1;
    background: var(--accent);
    color: var(--bone);
    font-size: var(--text-md);
    line-height: var(--leading-tight);
    padding-block: var(--space-sm);
    padding-inline: var(--space-md);
    max-inline-size: 12ch;
  }

  .cap {
    position: absolute;
    inset-inline-start: calc(var(--space-sm) * -1);
    inset-block-end: var(--space-lg);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--faint);
  }

  @media (--to-sm) {
    .badge {
      font-size: var(--text-sm);
      padding-block: var(--space-sm);
      padding-inline: var(--space-sm);
      inset-block-start: calc(var(--space-sm) * -1);
      inset-inline-start: calc(var(--space-xs) * -1);
    }
    .cap {
      inset-inline-start: calc(var(--space-xs) * -1);
    }
  }
</style>
