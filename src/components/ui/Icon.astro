---
/**
 * Wrapper para iconos de Lucide (`@lucide/astro`).
 * Homogeneiza tamaño y grosor de trazo, y aplica accesibilidad:
 *   - decorativo → `aria-hidden` (por defecto)
 *   - funcional  → `role="img"` + `aria-label` (pasa `label`)
 *
 * Uso: importa cada icono individualmente (tree-shaking) y pásalo por `icon`:
 *   import Mail from '@lucide/astro/icons/mail';
 *   <Icon icon={Mail} label="Email" />
 */
// Tipo del componente de icono, reutilizado de Lucide (todos comparten forma).
type LucideIcon = (typeof import('@lucide/astro/icons/chevron-down'))['default'];

interface Props {
  icon: LucideIcon;
  size?: number;
  strokeWidth?: number;
  label?: string;
  class?: string;
}

const { icon: Glyph, size = 22, strokeWidth = 1.6, label, class: className } = Astro.props;
---

{
  label ? (
    <Glyph size={size} stroke-width={strokeWidth} class={className} role="img" aria-label={label} />
  ) : (
    <Glyph size={size} stroke-width={strokeWidth} class={className} aria-hidden="true" />
  )
}
