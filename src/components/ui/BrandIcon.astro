---
/**
 * Iconos de marca (Facebook, Instagram, LinkedIn).
 *
 * Lucide dejó de incluir logotipos de terceros, así que se dibujan aquí.
 * Trazo abierto y grosor heredado para que combinen con los iconos de Lucide
 * que usa el resto del sitio.
 */
interface Props {
  network: 'facebook' | 'instagram' | 'linkedin';
  /** Nombre accesible. Si se omite, el icono se marca como decorativo. */
  label?: string;
  class?: string;
}

const { network, label, class: className } = Astro.props;

/* `role` debe ser un literal para que TypeScript lo acepte como AriaRole. */
const role = label ? ('img' as const) : undefined;
---

<svg
  class:list={['brand-icon', className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={role}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  {
    network === 'facebook' && (
      <path d="M17 2h-3a5 5 0 0 0-5 5v3H6v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
    )
  }
  {
    network === 'instagram' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    network === 'linkedin' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="2" />
        <path d="M7 10v7M7 7v.01M11 17v-4a2 2 0 0 1 4 0v4M11 10v7" />
      </>
    )
  }
</svg>

<style>
  .brand-icon {
    inline-size: 100%;
    block-size: 100%;
  }
</style>
