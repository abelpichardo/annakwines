---
/**
 * Botón / enlace en forma de píldora.
 *   - variant "solid"   → relleno vino (CTA del formulario).
 *   - variant "outline" → borde, hover invierte (CTA del nav).
 * Renderiza <a> si se pasa `href`, si no <button>.
 */
interface Props {
  href?: string;
  type?: 'button' | 'submit';
  variant?: 'solid' | 'outline';
  size?: 'sm' | 'md';
  /** Ocupa todo el ancho disponible. */
  block?: boolean;
  class?: string;
}

const {
  href,
  type = 'button',
  variant = 'solid',
  size = 'md',
  block = false,
  class: className,
} = Astro.props;

const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={['btn', variant, size, { block }, className]}
  href={href}
  type={href ? undefined : type}
>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-grid;
    place-items: center;
    font-family: var(--font-d);
    font-weight: var(--weight-medium);
    border-radius: var(--radius-pill);
    text-align: center;
    transition:
      transform var(--dur-base) var(--ease),
      background var(--dur-base) var(--ease),
      color var(--dur-base) var(--ease),
      box-shadow var(--dur-base) var(--ease);
  }

  .btn.md {
    font-size: var(--text-md);
    padding-block: var(--space-md);
    padding-inline: var(--space-xl);
  }

  .btn.sm {
    font-size: var(--text-sm);
    padding-block: var(--space-xs);
    padding-inline: var(--space-md);
  }

  .btn.block {
    inline-size: 100%;
  }

  .btn.solid {
    background: var(--accent);
    color: var(--bone);
  }

  .btn.outline {
    border: var(--border-hair) solid var(--fg);
  }

  /* El hover sólo se aplica donde hay puntero real: en táctil deja
     estados "pegados" tras el toque. */
  @media (--hover-capable) {
    .btn.solid:hover {
      transform: translateY(calc(var(--space-3xs) * -1));
      box-shadow: var(--shadow-btn);
    }
    .btn.outline:hover {
      background: var(--fg);
      color: var(--bg);
    }
  }

  @media (--to-sm) {
    .btn.md {
      inline-size: 100%;
    }
  }
</style>
