---
/**
 * Contenedor centrado de ancho máximo. Es la única pieza del sistema que
 * fija el ancho de lectura y el padding lateral del sitio, de modo que
 * cambiar `--maxw` o `--pad` reencuadra todas las páginas a la vez.
 *
 * `margin-inline: auto` es la excepción deliberada a la regla de "sin
 * margins": es centrado estructural, no separación entre elementos.
 */
interface Props {
  /** Etiqueta HTML a renderizar (`div` por defecto). */
  as?: 'div' | 'header' | 'footer' | 'nav' | 'section';
  class?: string;
}

const { as: Tag = 'div', class: className } = Astro.props;
---

<Tag class:list={['container', className]}><slot /></Tag>

<style>
  .container {
    inline-size: 100%;
    max-inline-size: var(--maxw);
    margin-inline: auto;
    padding-inline: var(--pad);
  }
</style>
