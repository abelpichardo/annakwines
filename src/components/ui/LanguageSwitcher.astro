---
/**
 * Conmutador de idioma. Enlaza a la MISMA página en el otro idioma, usando
 * su slug propio (`/catas` ↔ `/en/wine-events`), no a la portada: cambiar de
 * idioma nunca debe hacerte perder la página en la que estás.
 *
 * El script de interacciones añade el hash actual a cada enlace para
 * conservar también la sección.
 */
import { langCodes, type Lang } from '@i18n/ui';
import { pageUrl, type PageKey } from '@i18n/routes';

interface Props {
  current: Lang;
  page: PageKey;
}
const { current, page } = Astro.props;
---

<div class="lang" role="group" aria-label="Idioma / Language">
  {
    langCodes.map((lang) => (
      <a
        class:list={['lang-btn', { on: lang === current }]}
        href={pageUrl(page, lang)}
        lang={lang}
        hreflang={lang}
        data-lang-link
        aria-current={lang === current ? 'true' : undefined}
      >
        {lang.toUpperCase()}
      </a>
    ))
  }
</div>

<style>
  .lang {
    display: inline-grid;
    grid-auto-flow: column;
    align-items: center;
    gap: var(--space-3xs);
    border: var(--border-hair) solid var(--hair);
    border-radius: var(--radius-pill);
    padding: var(--space-3xs);
  }

  .lang-btn {
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    padding-block: var(--space-2xs);
    padding-inline: var(--space-xs);
    border-radius: var(--radius-pill);
    color: var(--faint);
    transition: color var(--dur-fast) var(--ease);
  }

  .lang-btn:hover {
    color: var(--fg);
  }

  .lang-btn.on {
    background: var(--accent);
    color: var(--bone);
  }
</style>
