---
/**
 * Conmutador de idioma (ES / EN / SV) como enlaces a la misma landing en cada
 * idioma — URLs reales e indexables, mejor para SEO que un swap por JS.
 * El script de interacciones añade el hash actual a cada enlace para
 * conservar la sección al cambiar de idioma.
 */
import { getRelativeLocaleUrl } from 'astro:i18n';
import { langCodes, type Lang } from '@i18n/ui';

interface Props {
  current: Lang;
}
const { current } = Astro.props;
---

<div class="lang" role="group" aria-label="Idioma / Language / Språk">
  {
    langCodes.map((lang) => (
      <a
        class:list={['lang-btn', { on: lang === current }]}
        href={getRelativeLocaleUrl(lang, '')}
        lang={lang}
        hreflang={lang}
        data-lang-link
        aria-current={lang === current ? 'true' : undefined}
      >
        {lang.toUpperCase()}
      </a>
    ))
  }
</div>

<style>
  .lang {
    display: inline-grid;
    grid-auto-flow: column;
    align-items: center;
    gap: var(--space-3xs);
    border: var(--border-hair) solid var(--hair);
    border-radius: var(--radius-pill);
    padding: var(--space-3xs);
  }

  .lang-btn {
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    padding-block: var(--space-2xs);
    padding-inline: var(--space-xs);
    border-radius: var(--radius-pill);
    color: var(--faint);
    transition: color var(--dur-fast) var(--ease);
  }

  .lang-btn:hover {
    color: var(--fg);
  }

  .lang-btn.on {
    background: var(--accent);
    color: var(--bone);
  }
</style>
