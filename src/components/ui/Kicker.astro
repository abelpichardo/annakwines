---
/**
 * Eyebrow en versalitas precedido de una línea corta.
 * Rotula un bloque sin competir con el título que lo acompaña.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['kicker', className]}><slot /></span>

<style>
  .kicker {
    display: inline-grid;
    grid-auto-flow: column;
    align-items: center;
    gap: var(--space-md);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--muted);
  }

  .kicker::before {
    content: '';
    inline-size: var(--size-seal);
    block-size: var(--border-hair);
    background: currentColor;
    opacity: 0.7;
  }
</style>
