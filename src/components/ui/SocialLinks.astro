---
/**
 * Bloque de redes sociales. Es una pieza destacada del sitio: el canal
 * principal de difusión de las catas son los grupos de Facebook, así que las
 * redes tienen que verse, no esconderse en el pie.
 *
 * Las cuentas marcadas como `pending` (aún sin crear) se renderizan como
 * texto inerte con una nota, nunca como un enlace roto.
 */
import BrandIcon from '@components/ui/BrandIcon.astro';
import type { SocialLink } from '@data/site';

interface Props {
  links: readonly SocialLink[];
  /** `row` para pies y barras; `cards` para bloques destacados. */
  variant?: 'row' | 'cards';
  /** Texto que acompaña a las cuentas aún no creadas. */
  pendingLabel?: string;
  class?: string;
}

const { links, variant = 'row', pendingLabel, class: className } = Astro.props;

const networkName = {
  facebook: 'Facebook',
  instagram: 'Instagram',
  linkedin: 'LinkedIn',
} as const;
---

<ul class:list={['social', variant, className]}>
  {
    links.map((link) => (
      <li>
        {link.pending || !link.href ? (
          <span class="item is-pending">
            <span class="ic">
              <BrandIcon network={link.network} />
            </span>
            <span class="text">
              <span class="handle">{link.handle}</span>
              {pendingLabel && <span class="sub">{pendingLabel}</span>}
            </span>
          </span>
        ) : (
          <a class="item" href={link.href} target="_blank" rel="noopener noreferrer">
            <span class="ic">
              <BrandIcon network={link.network} />
            </span>
            <span class="text">
              <span class="handle">{link.handle}</span>
              <span class="sub">{networkName[link.network]}</span>
            </span>
          </a>
        )}
      </li>
    ))
  }
</ul>

<style>
  .social {
    display: grid;
    gap: var(--space-sm);
  }

  .social.row {
    grid-auto-flow: column;
    justify-content: start;
  }

  .social.cards {
    grid-template-columns: repeat(auto-fit, minmax(var(--col-min), 1fr));
    gap: var(--space-md);
  }

  .item {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: var(--space-sm);
    padding-block: var(--space-sm);
    padding-inline: var(--space-md);
    border: var(--border-hair) solid var(--hair);
    border-radius: var(--radius-pill);
    transition:
      border-color var(--dur-base) var(--ease),
      color var(--dur-base) var(--ease);
  }

  .social.cards .item {
    border-radius: var(--radius-sm);
    padding-block: var(--space-md);
  }

  .ic {
    inline-size: var(--size-icon);
    block-size: var(--size-icon);
    color: var(--accent);
  }

  .text {
    display: grid;
  }

  .handle {
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
  }

  .sub {
    font-size: var(--text-xs);
    color: var(--muted);
  }

  a.item:hover {
    border-color: color-mix(in oklab, var(--accent) 45%, var(--hair));
  }

  /* Cuenta aún no creada: se muestra, pero no invita a pulsar. */
  .is-pending {
    opacity: 0.55;
    cursor: default;
  }

  .is-pending .ic {
    color: var(--muted);
  }

  @media (--to-sm) {
    .social.row {
      grid-auto-flow: row;
    }
  }
</style>
