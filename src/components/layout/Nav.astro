---
/**
 * Barra de navegación fija. Al hacer scroll >40px recibe `.shrunk` (vía el
 * script de interacciones): menos padding + fondo con blur.
 * Izquierda: wordmark · Centro: enlaces (ocultos ≤980px) · Derecha: idioma + CTA.
 */
import Brand from '@components/ui/Brand.astro';
import Button from '@components/ui/Button.astro';
import LanguageSwitcher from '@components/ui/LanguageSwitcher.astro';
import { navLinks } from '@data/site';
import { useTranslations } from '@i18n/utils';
import type { Lang } from '@i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<nav class="nav" id="nav">
  <Brand href="#top" />
  <div class="nav-mid">
    {navLinks.map((link) => <a href={link.href}>{t.nav[link.key]}</a>)}
  </div>
  <div class="nav-right">
    <LanguageSwitcher current={lang} />
    <Button href="#contact" variant="outline" size="sm">{t.nav.cta}</Button>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    inset-block-start: 0;
    inset-inline-start: 0;
    width: 100%;
    z-index: 80;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 22px;
    padding-inline: var(--pad);
    transition:
      padding 0.5s var(--ease),
      background 0.4s ease;
  }
  .nav.shrunk {
    padding-block: 14px;
    background: color-mix(in oklab, var(--bg) 80%, transparent);
    backdrop-filter: blur(12px);
  }

  .nav-mid {
    display: flex;
    gap: 30px;
  }
  .nav-mid a {
    font-size: 13.5px;
    color: var(--muted);
    position: relative;
    padding-block: 2px;
    transition: color 0.25s;
  }
  .nav-mid a::after {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-end: -2px;
    width: 0;
    height: 1px;
    background: var(--wine);
    transition: width 0.3s var(--ease);
  }
  .nav-mid a:hover {
    color: var(--fg);
  }
  .nav-mid a:hover::after {
    width: 100%;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  @media (max-width: 1080px) {
    .nav-mid {
      gap: 22px;
    }
  }
  @media (max-width: 980px) {
    .nav-mid {
      display: none;
    }
  }
  @media (max-width: 620px) {
    .nav {
      padding-block: 16px;
    }
    .nav.shrunk {
      padding-block: 12px;
    }
    .nav-right {
      gap: 10px;
    }
  }
</style>
