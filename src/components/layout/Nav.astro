---
/**
 * Barra de navegación fija. Al superar el umbral de scroll recibe `.shrunk`
 * (vía el script de interacciones): menos padding + fondo con blur.
 * Izquierda: wordmark · Centro: enlaces (ocultos bajo `--to-lg`) · Derecha:
 * conmutador de idioma + CTA.
 */
import Brand from '@components/ui/Brand.astro';
import Button from '@components/ui/Button.astro';
import LanguageSwitcher from '@components/ui/LanguageSwitcher.astro';
import { navLinks } from '@data/site';
import { useTranslations } from '@i18n/utils';
import type { Lang } from '@i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<nav class="nav" id="nav">
  <Brand href="#top" />
  <div class="mid">
    {navLinks.map((link) => <a href={link.href}>{t.nav[link.key]}</a>)}
  </div>
  <div class="right">
    <LanguageSwitcher current={lang} />
    <Button href="#contact" variant="outline" size="sm">{t.nav.cta}</Button>
  </div>
</nav>

<style>
  /* Rejilla de tres pistas: las laterales miden lo mismo, así el bloque
     central queda ópticamente centrado sin depender de space-between. */
  .nav {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: var(--z-nav);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding-block: var(--space-lg);
    padding-inline: var(--pad);
    transition:
      padding var(--dur-slower) var(--ease),
      background var(--dur-slow) var(--ease);
  }

  .nav.shrunk {
    padding-block: var(--space-md);
    background: color-mix(in oklab, var(--bg) 80%, transparent);
    backdrop-filter: blur(var(--space-sm));
  }

  .mid {
    display: grid;
    grid-auto-flow: column;
    gap: clamp(var(--space-lg), 2.4vw, var(--space-xl));
    justify-self: center;
  }

  .mid a {
    position: relative;
    font-size: var(--text-sm);
    color: var(--muted);
    padding-block: var(--space-3xs);
    transition: color var(--dur-fast) var(--ease);
  }

  /* Subrayado que crece desde la izquierda al pasar el ratón. */
  .mid a::after {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-end: calc(var(--space-3xs) * -1);
    inline-size: 0;
    block-size: var(--border-hair);
    background: var(--accent);
    transition: inline-size var(--dur-base) var(--ease);
  }

  .mid a:hover {
    color: var(--fg);
  }

  .mid a:hover::after {
    inline-size: 100%;
  }

  .right {
    display: grid;
    grid-auto-flow: column;
    align-items: center;
    gap: clamp(var(--space-xs), 1.6vw, var(--space-md));
    justify-self: end;
  }

  @media (--to-lg) {
    .nav {
      grid-template-columns: 1fr auto;
    }
    .mid {
      display: none;
    }
  }

  @media (--to-sm) {
    .nav {
      padding-block: var(--space-md);
    }
    .nav.shrunk {
      padding-block: var(--space-sm);
    }
  }
</style>
